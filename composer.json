{
    "name": "mubbashir786/prayer-times-laravel",
    "description": "Prayer times, Ramadan scheduling, and Adhan reminders for Laravel apps.",
    "keywords": ["laravel", "prayer-times", "ramadan", "adhan", "islamic"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mubbashir",
            "homepage": "https://github.com/mubbashir786"
        }
    ],
    "homepage": "https://github.com/mubbashir786/prayer-times-laravel",
    "support": {
        "issues": "https://github.com/mubbashir786/prayer-times-laravel/issues",
        "source": "https://github.com/mubbashir786/prayer-times-laravel"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Mubbashir786\\PrayerTimes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mubbashir786\\PrayerTimes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mubbashir786\\PrayerTimes\\PrayerTimesServiceProvider"
            ],
            "aliases": {
                "PrayerTimes": "Mubbashir786\\PrayerTimes\\Facades\\PrayerTimes"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
